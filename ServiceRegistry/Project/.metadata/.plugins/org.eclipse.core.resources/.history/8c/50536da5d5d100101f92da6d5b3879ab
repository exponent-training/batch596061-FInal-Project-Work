package com.ServiceImpl;

import java.util.List;
import java.util.stream.Collectors;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;
import com.DTO.EducationDTO;
import com.DTO.IncomeDTO;
import com.DTO.KidsDTO;
import com.DTO.SummeryDTO;
import com.Entity.CitizenApplication;
import com.Entity.DcEducation;
import com.Entity.DcIncome;
import com.Entity.DcKid;
import com.Repository.CitizenApplicationRepository;
import com.Repository.DcEducationRepository;
import com.Repository.DcIncomeRepository;
import com.Repository.DcKidRepository;
import com.Service.DataCollectService;

@Service
public class DataCollectServiceImpl implements DataCollectService {

 @Autowired private DcIncomeRepository incomeRepo;
 @Autowired private DcEducationRepository eduRepo;
 @Autowired private DcKidRepository kidRepo;
 @Autowired private CitizenApplicationRepository appRepo;

 @Override
 public boolean saveIncome(IncomeDTO dto,Integer appNum,Integer userId){
     CitizenApplication app = appRepo.findById(appNum).orElse(null);
     if(app==null) return false;

     DcIncome e = new DcIncome(null,dto.getSalaryIncome(),dto.getPropertyIncome(),app);
     incomeRepo.save(e);
     return true;
 }

 @Override
 public boolean saveEducation(EducationDTO dto,Integer appNum,Integer userId){
     CitizenApplication app = appRepo.findById(appNum).orElse(null);
     if(app==null) return false;

     DcEducation edu=new DcEducation(null,dto.getHighestDegree(),dto.getGradYear(),dto.getUniName(),app);
     eduRepo.save(edu);
     return true;
 }

 @Override
 public boolean saveKids(KidsDTO dto,Integer appNum,Integer userId){
     CitizenApplication app = appRepo.findById(appNum).orElse(null);
     if(app==null) return false;

     DcKid kid=new DcKid(null,dto.getKidName(),dto.getKidDob(),dto.getKidSsn(),app);
     kidRepo.save(kid);
     return true;
 }

 @Override
 public SummeryDTO getSummaryData(Integer appNum){

     SummeryDTO sum=new SummeryDTO();

     DcIncome i=incomeRepo.findByCitizenApplicationAppNumber(appNum);
     if(i!=null) sum.setIncomeDetails(new IncomeDTO(i.getSalaryIncome(),i.getPropertyIncome()));

     DcEducation e=eduRepo.findByCitizenApplicationAppNumber(appNum);
     if(e!=null) sum.setEducationDetails(new EducationDTO(e.getHighestDegree(),e.getGradYear(),e.getUniName()));

     List<DcKid> k=kidRepo.findByCitizenApplicationAppNumber(appNum);
     List<KidsDTO> list=k.stream()
           .map(x-> new KidsDTO(x.getKidName(),x.getKidDob(),x.getKidSsn()))
           .collect(Collectors.toList());
     sum.setKidsDetails(list);

     return sum;
 }
}
