package com.ServiceImpl;

@Service
public class DataCollectServiceImpl implements DataCollectService {

    @Autowired private DcIncomeRepository incomeRepo;
    @Autowired private DcEducationRepository eduRepo;
    @Autowired private DcKidRepository kidRepo;
    @Autowired private CitizenApplicationRepository appRepo;


    @Override
    public boolean saveIncome(IncomeDTO dto, Integer appNum, Integer userId) {
        CitizenApplication app = appRepo.findById(appNum).orElse(null);
        if(app==null) return false;

        DcIncome income = new DcIncome(null, dto.getSalaryIncome(), dto.getPropertyIncome(), app);
        incomeRepo.save(income);
        return true;
    }

    @Override
    public boolean saveEducation(EducationDTO dto, Integer appNum, Integer userId) {
        CitizenApplication app = appRepo.findById(appNum).orElse(null);
        if(app==null) return false;

        DcEducation edu = new DcEducation(null, dto.getHighestDegree(), dto.getGradYear(), dto.getUniName(), app);
        eduRepo.save(edu);
        return true;
    }

    @Override
    public boolean saveKids(KidsDTO dto, Integer appNum, Integer userId) {
        CitizenApplication app = appRepo.findById(appNum).orElse(null);
        if(app==null) return false;

        DcKid kid = new DcKid(null, dto.getKidName(), dto.getKidDob(), dto.getKidSsn(), app);
        kidRepo.save(kid);
        return true;
    }

    @Override
    public SummeryDTO getSummaryData(Integer appNum) {

        SummeryDTO sum = new SummeryDTO();

        DcIncome i = incomeRepo.findByCitizenApplication_AppNumber(appNum);
        if(i!=null) sum.setIncomeDetails(new IncomeDTO(i.getSalaryIncome(), i.getPropertyIncome()));

        DcEducation e = eduRepo.findByCitizenApplication_AppNumber(appNum);
        if(e!=null) sum.setEducationDetails(new EducationDTO(e.getHighestDegree(), e.getGradYear(), e.getUniName()));

        List<DcKid> kids = kidRepo.findByCitizenApplication_AppNumber(appNum);
        sum.setKidsDetails(kids.stream()
                .map(k -> new KidsDTO(k.getKidName(), k.getKidDob(), k.getKidSsn()))
                .collect(Collectors.toList())
        );

        return sum;
    }
}
