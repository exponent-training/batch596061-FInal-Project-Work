package com.ServiceImpl;

import java.time.LocalDate;
import java.util.List;
import java.util.stream.Collectors;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;

import com.DTO.CitizenApplicationRequestDTO;
import com.DTO.CitizenApplicationResponseDTO;
import com.Entity.CitizenApplication;
import com.Entity.PlanMaster;
import com.Entity.User;
import com.Repository.CitizenApplicationRepository;
import com.Repository.PlanMasterRepository;
import com.Repository.UserRepository;
import com.Service.CitizenApplicationService;

@Service
public class CitizenAppServiceImpl implements CitizenApplicationService {

    @Autowired
    private CitizenApplicationRepository repo;

    @Autowired
    private UserRepository userRepo;

    @Autowired
    private PlanMasterRepository planRepo;

    // Create Application
    @Override
    public boolean createApplication(CitizenApplicationRequestDTO dto) {

        if (repo.existsBySsn(dto.getSsn()))
            throw new RuntimeException("Application already exists with this SSN");

        User user = userRepo.findById(dto.getUserId())
                .orElseThrow(() -> new RuntimeException("User not found"));

        PlanMaster plan = planRepo.findById(dto.getPlanId())
                .orElseThrow(() -> new RuntimeException("Plan not found"));

        CitizenApplication app = new CitizenApplication();
        app.setFullname(dto.getFullname());
        app.setGender(dto.getGender());
        app.setDob(dto.getDob());
        app.setSsn(dto.getSsn());
        app.setUser(user);
        app.setPlan(plan);
        app.setCreatedDate(LocalDate.now());

        repo.save(app);
        return true;
    }

    // Get by Application Number
    @Override
    public CitizenApplicationResponseDTO getApp(Integer appNum) {
        CitizenApplication app = repo.findById(appNum)
                .orElseThrow(() -> new RuntimeException("Application not found"));
        return convertToResponse(app);
    }

    // Get All
    @Override
    public List<CitizenApplicationResponseDTO> getApps() {
        return repo.findAll()
                .stream()
                .map(this::convertToResponse)
                .collect(Collectors.toList());
    }

    // ⭐ Get by SSN
    @Override
    public CitizenApplicationResponseDTO getAppWithCitizenId(Integer citizenId) {
        CitizenApplication app = repo.findBySsn(Long.valueOf(citizenId))
                .orElseThrow(() -> new RuntimeException("No Application found with this SSN"));
        return convertToResponse(app);
    }

    private CitizenApplicationResponseDTO convertToResponse(CitizenApplication app) {
        CitizenApplicationResponseDTO dto = new CitizenApplicationResponseDTO();
        dto.setAppNumber(app.getAppNumber());
        dto.setFullname(app.getFullname());
        dto.setGender(app.getGender());
        dto.setDob(app.getDob());
        dto.setSsn(app.getSsn());
        dto.setPlanName(app.getPlan().getPlanName());
        dto.setEmail(app.getUser().getEmail());
        dto.setCreatedDate(app.getCreatedDate());
        return dto;
    }
}
