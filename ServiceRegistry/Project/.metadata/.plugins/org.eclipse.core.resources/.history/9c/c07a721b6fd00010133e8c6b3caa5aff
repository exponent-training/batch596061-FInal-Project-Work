package com.ServiceImpl;

import org.springframework.stereotype.Service;

@@Service
public class CitizenAppServiceImpl implements CitizenApplicationService {

    @Autowired
    private CitizenApplicationRepository repo;

    @Autowired
    private UserRepository userRepo;

    @Autowired
    private PlanMasterRepository planRepo;

    // ===================== Create Application =====================
    @Override
    public boolean createApplication(CitizenApplicationRequestDTO dto) {

        // SSN already exists check
        if(repo.existsBySsn(dto.getSsn())) {
            throw new RuntimeException("Application already exists with this SSN");
        }

        // User fetch
        User user = userRepo.findById(dto.getUserId()).orElse(null);
        if(user == null) {
            throw new RuntimeException("User not found");
        }

        // Plan fetch
        PlanMaster plan = planRepo.findById(dto.getPlanId()).orElse(null);
        if(plan == null) {
            throw new RuntimeException("Plan not found");
        }

        // DTO to Entity convert - simple way
        CitizenApplication app = new CitizenApplication();
        app.setFullname(dto.getFullname());
        app.setDob(dto.getDob());
        app.setGender(dto.getGender());
        app.setSsn(dto.getSsn());
        app.setUser(user);
        app.setPlan(plan);
        app.setCreatedDate(LocalDate.now());

        repo.save(app);

        return true;
    }

    // ===================== Get Application By App Number =====================
    @Override
    public CitizenApplicationResponseDTO getApp(Integer appNum) {

        CitizenApplication app = repo.findById(appNum).orElse(null);

        if(app == null)
            throw new RuntimeException("Application not found");

        return convertToResponse(app);
    }

    // ===================== Get All Applications =====================
    @Override
    public List<CitizenApplicationResponseDTO> getApps() {

        List<CitizenApplication> list = repo.findAll();
        List<CitizenApplicationResponseDTO> responseList = new ArrayList<>();

        for(CitizenApplication app : list){
            responseList.add(convertToResponse(app));
        }

        return responseList;
    }

    // ===================== Get Application By Citizen(User) ID =====================
    @Override
    public CitizenApplicationResponseDTO getAppWithCitizenId(Integer citizenId) {

        CitizenApplication app = repo.findByUser_UserId(citizenId).orElse(null);

        if(app == null)
            throw new RuntimeException("No Application Found for Citizen");

        return convertToResponse(app);
    }

    // ===================== Convert Entity to Response DTO =====================
    private CitizenApplicationResponseDTO convertToResponse(CitizenApplication app){

        CitizenApplicationResponseDTO dto = new CitizenApplicationResponseDTO();

        dto.setAppNumber(app.getAppNumber());
        dto.setFullname(app.getFullname());
        dto.setGender(app.getGender());
        dto.setDob(app.getDob());
        dto.setSsn(app.getSsn());
        dto.setCreatedDate(app.getCreatedDate());

        dto.setPlanName(app.getPlan().getPlanName());
        dto.setUserEmail(app.getUser().getEmail());

        return dto;
    }
}
