package com.Controller;


import java.util.List;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.web.bind.annotation.*;

import com.DTO.CitizenAppDTO;
import com.Service.CitizenAppService;
import com.Service.CitizenApplicationService;

@RestController
@RequestMapping("/api/apps")
public class CitizenAppController {

    @Autowired
    private CitizenApplicationService service;

    // Citizen Apply for Application
    @PostMapping
    public String createApp(@RequestBody CitizenAppDTO dto) {
        service.createApplication(dto);
        return "Citizen Application Created Successfully!";
    }

    // Admin / Citizen : get one app
    @GetMapping("/{appNum}")
    public CitizenAppDTO getApp(@PathVariable Integer appNum) {
        return service.getApp(appNum);
    }

    // Admin: get all applications
    @GetMapping
    public List<CitizenAppDTO> getAllApps() {
        return service.getApps();
    }

    // Citizen: get application using Citizen(User) ID
    @GetMapping("/citizen/{userId}")
    public CitizenAppDTO getByCitizenId(@PathVariable Integer userId) {
        return service.getAppWithCitizenId(userId);
    }
}
