	public boolean isFromRhodeIsland(String ssn) {
	    // Remove dashes if any
	    ssn = ssn.replace("-", "");

	    if (ssn.length() != 9) {
	        throw new IllegalArgumentException("Invalid SSN format");
	    }
	    
	    String area = ssn.substring(0, 3);  // First 3 digits
	    return area.equals("035") || area.equals("036");
	}

	
