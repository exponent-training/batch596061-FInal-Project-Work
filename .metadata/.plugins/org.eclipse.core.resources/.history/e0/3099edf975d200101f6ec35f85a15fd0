    @Override
    public boolean saveEducation(EducationDTO dto, Integer appNum, Integer userId) {
        CitizenApplication app = appRepo.findById(appNum).orElse(null);
        if(app==null) return false;

        DcEducation edu = new DcEducation(null, dto.getHighestDegree(), dto.getGradYear(), dto.getUniName(), app);
        eduRepo.save(edu);
        return true;
    }

    @Override
    public boolean saveKids(KidsDTO dto, Integer appNum, Integer userId) {
        CitizenApplication app = appRepo.findById(appNum).orElse(null);
        if(app==null) return false;

        DcKid kid = new DcKid(null, dto.getKidName(), dto.getKidDob(), dto.getKidSsn(), app);
        kidRepo.save(kid);
        return true;
    }

    @Override
    public SummeryDTO getSummaryData(Integer appNum) {

        SummeryDTO sum = new SummeryDTO();

        DcIncome i = incomeRepo.findByCitizenApplicationAppNumber(appNum);
        if(i!=null) sum.setIncomeDetails(new IncomeDTO(i.getSalaryIncome(), i.getPropertyIncome()));

        DcEducation e = eduRepo.findByCitizenApplicationAppNumber(appNum);
        if(e!=null) sum.setEducationDetails(new EducationDTO(e.getHighestDegree(), e.getGradYear(), e.getUniName()));

        List<DcKid> kids = kidRepo.findByCitizenApplicationAppNumber(appNum);
        sum.setKidsDetails(kids.stream()
                .map(k -> new KidsDTO(k.getKidName(), k.getKidDob(), k.getKidSsn()))
                .collect(Collectors.toList())
        );

        return sum;
    }
}
