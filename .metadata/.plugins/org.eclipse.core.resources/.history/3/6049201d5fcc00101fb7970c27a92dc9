package com.cf.pm.serviceimple;

import java.util.List;
import java.util.stream.Collectors;

import org.modelmapper.ModelMapper;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;

import com.cf.pm.dto.PlanDto;
import com.cf.pm.dto.UpdatePlanDto;
import com.cf.pm.entity.Plans;
import com.cf.pm.enums.ActiveStatus;
import com.cf.pm.exception.PlanDoesNotExist;
import com.cf.pm.repo.PlanRepo;
import com.cf.pm.service.PlanService;

import lombok.extern.slf4j.Slf4j;

@Service
@Slf4j
public class PlanServiceImple implements PlanService {
	@Autowired
	private PlanRepo pr;

	@Override
	public boolean savePlan(PlanDto plandto) {

		log.info("PlanService : {}", plandto);

		ModelMapper mm = new ModelMapper();
		Plans plan = mm.map(plandto, Plans.class);

		log.info("Mapped Plan : {}", plan);

		Plans saved = pr.save(plan);

		return saved.getPlanId() != null;
	}

	@Override
	public List<PlanDto> getPlans() {
		List<Plans> allPlans = pr.findAll();

		ModelMapper mm = new ModelMapper();

		List<PlanDto> listDto = allPlans.stream().map(plan -> mm.map(plan, PlanDto.class)).collect(Collectors.toList());

		log.info("List of All Plans : " + listDto);

		return listDto;
	}

	@Override
	public PlanDto getPlan(Integer planId) {
		Plans plan = pr.findById(planId).orElseThrow(() -> new PlanDoesNotExist("Plan not found with ID: " + planId));
		ModelMapper mm = new ModelMapper();
		PlanDto pd = mm.map(plan, PlanDto.class);

		return pd;
	}

	@Override
	public boolean updatePlan(Integer planId, UpdatePlanDto updateDto) {
		Plans p = pr.findById(planId).orElseThrow(() -> new PlanDoesNotExist("Plan not found with ID: " + planId));
		
		 p.setPlanName(updateDto.getPlanName());
		    p.setPlanStartDate(updateDto.getPlanStartDate());
		    p.setPlanEndDate(updateDto.getPlanEndDate());
		    p.setActiveS(updateDto.getActiveS());
		    p.setComments(updateDto.getComments());

		    pr.save(p);
		    
		    return true;
		
		
	}

}
