	@Override
	public boolean createApplication(CitizenDto citizendto) {
		log.info("Citizen Service : " + citizendto);
		

		    log.info("Citizen Service : " + citizendto);

		    String ssn = citizendto.getSsn();

		    String stateName;
		    if (ssn.startsWith("12")) {             // Example condition
		        stateName = "Rhode Island";
		    } else {
		        stateName = "Other State";
		    }

		    log.info("State based on SSN: " + stateName);

		   
		    if (stateName.equalsIgnoreCase("Rhode Island")) {

		        Authentication authentication = 
		                SecurityContext.getContext().getAuthentication();
		        User authenticatedUser = (User) ((SecurityContext) authentication).getPrincipal();

		        ModelMapper mapper = new ModelMapper();
		        Citizen cap = mapper.map(citizendto, Citizen.class);

		        cap.setUser(authenticatedUser);

		        Plans plan = pr.existsByPlanName(citizendto.getPlanName())
		                .orElseThrow(() -> 
		                    new PlanNotFoundWithName("Plan Doesn’t Exist with this name")
		                );

		        cap.setPlan(plan);

		        citizenArRepo.save(cap);

		        return true;
		    }

		    // SSN does not belong to Rhode Island
		    return false;
		}

		return false;
	}

