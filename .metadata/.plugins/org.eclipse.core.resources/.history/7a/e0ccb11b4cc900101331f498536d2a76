	        throw new EmailNotFoundException("Email does not match for this user");
	    }

	   
	    String newPassword = passwordGenerator.generate();

	    
	    user.setPassword(passwordEncoder.encode(newPassword));
	    userRepo.save(user);


	    return true;
	}
}
