package com.cf.ar.exception;

import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.ExceptionHandler;
import org.springframework.web.bind.annotation.RestControllerAdvice;


import lombok.extern.slf4j.Slf4j;


@Slf4j
@RestControllerAdvice
public class GlobalExceptionHandling {
   
	@ExceptionHandler(value = PlanNotFoundWithName.class)
	public ResponseEntity<?> handlePlanNotFound(PlanNotFoundWithName ex){
		 log.warn("{Plan does not exists."+ ex.getMessage());
		return new ResponseEntity("Invalid Plan Id " + ex.getMessage(), HttpStatus.NOT_FOUND);
		
	}
	@ExceptionHandler(value = UserNotFound.class)
	public ResponseEntity<?> handleUserNotFound(UserNotFound ex){
		log.warn("{User does not exists."+ ex.getMessage());
		return new ResponseEntity("Invalid User Id " + ex.getMessage(), HttpStatus.NOT_FOUND);
		
	}
	@ExceptionHandler(value = WrongSsnException.class)
	public ResponseEntity<?> handleWrongSsn(UserNotFound ex){
		log.warn("{Wrong SSN Entered ."+ ex.getMessage());
		return new ResponseEntity("Invalid SSN " + ex.getMessage(), HttpStatus.NOT_FOUND);
		
	}
}
