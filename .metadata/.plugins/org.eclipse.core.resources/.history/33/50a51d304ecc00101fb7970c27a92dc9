@RestController
@Slf4j
@RequestMapping("/cf/ar")
public class CitizenController {
  
	 @Autowired
	    private CitizenService citizenService;
	 
	

	    @PostMapping("/create")
	    @Operation(description = "Citizen created ",summary = "Citizen Creation")
	    public ResponseEntity<String> createApplication(@Valid @RequestBody CitizenDto citizenDto ) {

	        boolean isCreated = citizenService.createApplication(citizenDto);

	        if (isCreated) {
	            return new ResponseEntity<>("Application Created", HttpStatus.OK);
	        } else {
	            return new ResponseEntity<>("Application Not Created", HttpStatus.INTERNAL_SERVER_ERROR);
	        }
	    }
	    
	    

