package com.Controller;

import javax.validation.Valid;

import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;

import com.DTO.ForgetPasswordDTO;
import com.DTO.LoginRequestDTO;
import com.DTO.LoginResposneDTO;
import com.DTO.SignUpDTO;
import com.Service.UserServices;

import io.swagger.v3.oas.annotations.parameters.RequestBody;
import lombok.RequiredArgsConstructor;

@RestController
@RequestMapping("/auth")
@RequiredArgsConstructor
public class AuthController {

    private final UserServices service;

    @PostMapping("/signup")
    public ResponseEntity<String> signUp(@Valid @RequestBody SignUpDTO dto) {
        return ResponseEntity.ok(service.signUp(dto));
    }

    @PostMapping("/login")
    public ResponseEntity<LoginResposneDTO> login(@Valid @RequestBody LoginRequestDTO dto) {
        return ResponseEntity.ok(service.login(dto));
    }

    @PostMapping("/forget-password")
    public ResponseEntity<String> changePassword(@Valid @RequestBody ForgetPasswordDTO dto) {
        return ResponseEntity.ok(service.forgetPassword(dto));
    }
}
