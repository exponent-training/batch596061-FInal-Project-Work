package com.ServiceImpl;

@Service
public class DataCollectServiceImpl implements DataCollectService {

	@Autowired private DcIncomeRepository incomeRepo;
	@Autowired private DcEducationRepository eduRepo;
	@Autowired private DcKidRepository kidRepo;
	@Autowired private CitizenApplicationRepository appRepo;
	@Autowired private UserRepository userRepo;

	@Override
	public boolean saveIncome(IncomeDTO income, Integer appNum, Integer userId) {

		User user = userRepo.findById(userId)
				.orElseThrow(() -> new RuntimeException("User Not Found"));

		List<CitizenApplication> apps = appRepo.findByUser(user);
		CitizenApplication app = apps.stream()
				.filter(a -> a.getAppNumber().equals(appNum))
				.findFirst()
				.orElseThrow(() -> new RuntimeException("Application Not Found"));

		DcIncome obj = new DcIncome(null, income.getSalaryIncome(), income.getPropertyIncome(), app);
		return incomeRepo.save(obj) != null;
	}

	@Override
	public boolean saveEducation(EducationDTO dto, Integer appNum, Integer userId) {
		CitizenApplication app = appRepo.findById(appNum).orElse(null);
		if(app == null) return false;

		eduRepo.save(new DcEducation(null, dto.getHighestDegree(), dto.getGradYear(), dto.getUniName(), app));
		return true;
	}

	@Override
	public boolean saveKids(KidsDTO dto, Integer appNum, Integer userId) {
		CitizenApplication app = appRepo.findById(appNum).orElse(null);
		if(app == null) return false;

		kidRepo.save(new DcKid(null, dto.getKidName(), dto.getKidDob(), dto.getKidSsn(), app));
		return true;
	}

	@Override
	public SummeryDTO getSummaryData(Integer appNum) {

		SummeryDTO sum = new SummeryDTO();

		DcIncome inc = incomeRepo.findByCitizenApplicationAppNumber(appNum);
		if(inc != null)
			sum.setIncomeDetails(new IncomeDTO(inc.getSalaryIncome(), inc.getPropertyIncome()));

		DcEducation edu = eduRepo.findByCitizenApplicationAppNumber(appNum);
		if(edu != null)
			sum.setEducationDetails(new EducationDTO(edu.getHighestDegree(), edu.getGradYear(), edu.getUniName()));

		List<DcKid> kids = kidRepo.findByCitizenApplicationAppNumber(appNum);
		sum.setKidsDetails(kids.stream()
				.map(k -> new KidsDTO(k.getKidName(), k.getKidDob(), k.getKidSsn()))
				.collect(Collectors.toList()));

		return sum;
	}
}
